# Local AgentsLedge API base URL. Do not add /agents or /docs here.
AGENTLEDGE_API_BASE_URL=http://127.0.0.1:8000

# Must match the backend OAUTH_ISSUER and AGENTMESH_MCP_RESOURCE_URL exactly.
AGENTLEDGE_OAUTH_ISSUER=http://127.0.0.1:8000
AGENTMESH_MCP_PUBLIC_URL=http://127.0.0.1:8011/mcp

# Request timeout in seconds.
AGENTLEDGE_API_TIMEOUT_SECONDS=10

# Remote host process settings (the platform proxy must provide HTTPS).
AGENTMESH_MCP_TRANSPORT=stdio
AGENTMESH_MCP_HOST=127.0.0.1
AGENTMESH_MCP_PORT=8011

# OAuth tokens are verified by backend introspection for each remote MCP request.
# Tools remain limited to service discovery, categories and provider comparison.
